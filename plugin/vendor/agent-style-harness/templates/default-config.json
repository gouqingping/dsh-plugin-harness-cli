{
  "version": 1,
  "profile": "google",
  "languages": {
    "python": { "enabled": false, "engine": "yapf", "severity": "error", "importSorting": true },
    "typescript": { "enabled": false, "engine": "gts", "severity": "error" },
    "java": { "enabled": false, "engine": "google-java-format", "severity": "error" },
    "cpp": { "enabled": false, "engine": "clang-format", "severity": "error", "clangTidy": false },
    "shell": { "enabled": false, "engine": "shfmt", "severity": "warning", "shellcheck": true },
    "go": { "enabled": false, "engine": "gofmt", "severity": "error" }
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },
  "exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js"
  ]
}
