<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>进行中的任务 · 总览</title>
<style>
  :root { --bg:#0f1115; --card:#181c23; --line:#2a3140; --fg:#e6e9ef; --dim:#98a2b3;
          --ok:#22c55e; --run:#3b82f6; }
  * { box-sizing: border-box; }
  body { margin:0; padding:28px 20px 60px; background:var(--bg); color:var(--fg);
         font:15px/1.6 -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; }
  main { max-width: 920px; margin: 0 auto; }
  h1 { font-size: 22px; margin: 0 0 6px; }
  h2 { font-size: 16px; margin: 28px 0 10px; }
  .meta { color:var(--dim); font-size: 13px; margin: 0 0 4px; }
  table { width:100%; border-collapse: collapse; background:var(--card); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  th, td { text-align:left; padding:10px 14px; border-bottom:1px solid var(--line); font-size:14px; }
  th { color:var(--dim); font-weight:500; }
  tr:last-child td { border-bottom:0; }
  a { color:var(--fg); }
  .num { font-variant-numeric: tabular-nums; }
  code { background:#0b0e13; border:1px solid var(--line); border-radius:6px; padding:1px 5px; font-size:12px; }
</style>
</head>
<body>
<main data-index>
  <h1>进行中的任务</h1>
  <p class="meta">
    由 <code>node {{prototypeCheck}} --sync</code> 从各任务页汇总生成，不要手改。
    最后同步：<time data-synced datetime="{{todayIso}}">{{todayIso}}</time>
  </p>

  <table>
    <thead><tr><th>任务</th><th>总进度</th><th>状态</th><th>UI 设计</th><th>最近更新</th></tr></thead>
    <tbody data-tasks="active">
<!-- active:begin -->
<!-- active:end -->
    </tbody>
  </table>
  <p class="meta" data-empty-hint>没有进行中的任务：先跑 <code>dsh-plugin-harness-cli page &lt;kebab-任务名&gt;</code> 建一张任务页。</p>

  <h2>最近完成</h2>
  <table>
    <thead><tr><th>任务</th><th>总进度</th><th>状态</th><th>UI 设计</th><th>最近更新</th></tr></thead>
    <tbody data-tasks="done">
<!-- done:begin -->
<!-- done:end -->
    </tbody>
  </table>
</main>
<noscript><style>.hcli-skeleton{display:none!important}</style></noscript>
<style>
  .hcli-skeleton{position:fixed;inset:0;z-index:9998;background:#f5f5f5;padding:24px;box-sizing:border-box;
    transition:opacity .18s ease;overflow:hidden}
  .hcli-skeleton.is-hidden{opacity:0;visibility:hidden;pointer-events:none}
  .hcli-sk{border-radius:8px;background:linear-gradient(90deg,#ececec 25%,#f7f7f7 37%,#ececec 63%);
    background-size:400% 100%;animation:hcli-sk 1.15s ease infinite;margin-bottom:12px}
  @keyframes hcli-sk{0%{background-position:100% 50%}100%{background-position:0 50%}}
  .hcli-sk-row{display:flex;gap:12px}
  .hcli-sk-row .hcli-sk{flex:1;margin-bottom:0}
</style>
<div class="hcli-skeleton" id="hcli-skeleton" aria-hidden="true">
  <div class="hcli-sk" style="width:220px;height:26px"></div>
  <div class="hcli-sk" style="width:100%;height:52px"></div>
  <div class="hcli-sk-row">
    <div class="hcli-sk" style="height:120px"></div>
    <div class="hcli-sk" style="height:120px"></div>
    <div class="hcli-sk" style="height:120px"></div>
  </div>
  <div class="hcli-sk" style="width:100%;height:180px"></div>
  <div class="hcli-sk" style="width:65%;height:18px"></div>
  <div class="hcli-sk" style="width:85%;height:18px"></div>
</div>
<script>
(function(){
  var el = document.getElementById('hcli-skeleton');
  if (!el) return;
  function hide() {
    el.classList.add('is-hidden');
    setTimeout(function(){ if (el.parentNode) el.parentNode.removeChild(el); }, 260);
  }
  if (document.readyState === 'complete') setTimeout(hide, 300);
  else window.addEventListener('load', function(){ setTimeout(hide, 300); });
})();
</script>
</body>
</html>
